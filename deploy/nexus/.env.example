# Copy to .env and edit. The .env file holds secrets: never commit it.

# Password of the hub's PostgreSQL user. Use letters and digits only (it goes into a URL).
# Generate one with:  openssl rand -hex 24
NEXUS_DB_PASSWORD=

# The address schools type to join, e.g. https://nexus.example.org (shown in invitations).
NEXUS_PUBLIC_URL=

# Optional. One-time token for first-run setup. Leave empty and the hub prints a generated
# one in its log (docker compose logs nexus). It stops working once setup is done.
NEXUS_SETUP_TOKEN=

# Only with "--profile https": the domain name Caddy gets a certificate for.
NEXUS_DOMAIN=

# Optional. Use a specific image instead of the latest release, or a locally built one.
# NEXUS_IMAGE=ghcr.io/quietbytehq/madrasa-nexus:0.3.1
# Optional. Host address and port the hub listens on (default 127.0.0.1:4780).
# NEXUS_LISTEN=127.0.0.1
# NEXUS_PORT=4780
