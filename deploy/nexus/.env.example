# Copy to .env and edit. The .env file holds secrets: never commit it.

# Password of the hub's PostgreSQL user. Use letters and digits only (it goes into a URL).
# Generate one with:  openssl rand -hex 24
NEXUS_DB_PASSWORD=

# The address schools type to join, e.g. https://nexus.example.org (shown in invitations).
NEXUS_PUBLIC_URL=

# How many reverse proxies stand in front of the hub. The hub limits sign-in, join-code and
# access-code attempts per client address; behind a proxy it reads that address from the
# X-Forwarded-For header, and must know how many proxies added to it. 0: none (reached
# directly). 1: the bundled Caddy (--profile https) or one proxy of your own. Do not set it
# higher than the truth: a client could then choose the address it is counted under.
NEXUS_TRUSTED_PROXIES=0

# Optional. One-time token for first-run setup. Leave empty and the hub prints a generated
# one in its log (docker compose logs nexus). It stops working once setup is done.
NEXUS_SETUP_TOKEN=

# Only with "--profile https": the domain name Caddy gets a certificate for.
NEXUS_DOMAIN=

# Optional. Use a specific release instead of the latest (recommended: the same version as
# the schools). Release tags always end in -alpha for now.
# NEXUS_IMAGE=ghcr.io/quietbytehq/madrasa-nexus:0.5.1-alpha
# Optional. Host address and port the hub listens on (default 127.0.0.1:4780).
# NEXUS_LISTEN=127.0.0.1
# NEXUS_PORT=4780
