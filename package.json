{
  "name": "madrasa",
  "private": true,
  "version": "0.6.1",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter madrasa-desktop dev",
    "tauri": "pnpm --filter madrasa-desktop tauri",
    "build": "pnpm --filter madrasa-desktop build",
    "build:console": "pnpm --filter madrasa-desktop build:console",
    "dev:parent": "pnpm --filter madrasa-parent dev",
    "build:parent": "pnpm --filter madrasa-parent build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "manual": "scripts/build-manual.sh",
    "manual:screenshots": "scripts/manual-screenshots.sh",
    "e2e": "scripts/e2e.sh",
    "e2e:typecheck": "tsc -p e2e --noEmit",
    "e2e:format:check": "pnpm --filter madrasa-desktop exec prettier --config ../../e2e/.prettierrc --check \"../../e2e/**/*.{ts,mjs}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  }
}
